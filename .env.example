# SunPower One - Environment Configuration Template
# Copy this file to .env and fill in your values

# =============================================================================
# SUPABASE CONFIGURATION (Required)
# =============================================================================
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
# Project Settings > API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key - ONLY for server-side/Edge Functions
# NEVER expose this in the browser or client-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# SUPABASE LOCAL DEVELOPMENT (Optional - for supabase start)
# =============================================================================
# These are used when running `supabase start` for local development
# Default local Supabase URLs (usually don't need to change)

# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# SUPABASE_STUDIO_URL=http://127.0.0.1:54323

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
VITE_APP_NAME=SunPower One
VITE_APP_URL=http://localhost:5173

# =============================================================================
# GOOGLE STITCH DESIGN SYSTEM (Optional - for design token sync)
# =============================================================================
# STITCH_PROJECT_ID=11813858513178811754
# STITCH_API_KEY=your-stitch-api-key

# =============================================================================
# EXTERNAL INTEGRATIONS (Future phases)
# =============================================================================
# GOOGLE_MAPS_API_KEY=your-google-maps-key
# WHATSAPP_BUSINESS_API_TOKEN=your-whatsapp-token
# EMAIL_SERVICE_API_KEY=your-email-service-key
# SMS_SERVICE_API_KEY=your-sms-key

# =============================================================================
# FEATURE FLAGS
# =============================================================================
VITE_ENABLE_AI_ASSISTANT=false
VITE_ENABLE_DEMO_DATA=true
VITE_ENABLE_PLAYWRIGHT_TESTS=false

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
# VITE_REACT_DEVTOOLS=true
# VITE_TANSTACK_QUERY_DEVTOOLS=true